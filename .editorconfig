# Editor configuration, see http://editorconfig.org
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
indent_style = space
end_of_line = lf
insert_final_newline = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.py, *.sh]
indent_size = 4
trim_trailing_whitespace = true

[*.js, *.ts, *.scss, *.css, *.html]
indent_size = 2
trim_trailing_whitespace = true

[*.md, *.rst]
indent_size = 4
trim_trailing_whitespace = false
